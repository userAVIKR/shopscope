{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "sourceMap": true,
    "noEmit": true
  },
  "include": [
    "src",
    "database",
    "tests",
    "vitest.config.ts",
    "prisma.config.ts",
    "vitest.ai.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
