# Server
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# Application database (Prisma) — full access to shopscope_app only
APP_DATABASE_URL=postgresql://shopscope_app_user:CHANGE_ME@localhost:5432/shopscope_app

# Analytics database (pg) — read-only role on shopscope_analytics only
ANALYTICS_DATABASE_URL=postgresql://shopscope_reader:CHANGE_ME@localhost:5432/shopscope_analytics

# Local AI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_MS=60000

# Auth — long random string used to sign session cookies
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
